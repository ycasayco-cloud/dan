    },
    {
      "name": "Verificar 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/pacientes/{{testPatientId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pacientes",
            "{{testPatientId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
