{
  "info": {
    "name": "RuralMed - Pruebas datos ficticios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://TU-SERVICIO.onrender.com"
    },
    {
      "key": "testPatientId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Salud",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"API disponible\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar Pacientes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/pacientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pacientes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Lista con al menos 30 registros\",()=>{pm.response.to.have.status(200); pm.expect(pm.response.json().length).to.be.at.least(30);});"
            ]
          }
        }
      ]
    },
