    {
      "name": "Crear paciente de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pacientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pacientes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Paciente Prueba Postman\",\n  \"documento\": \"99999999\",\n  \"telefono\": \"900000000\",\n  \"comunidad\": \"Tarma\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Creado\",()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201)pm.collectionVariables.set(\"testPatientId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Leer paciente creado",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/pacientes/{{testPatientId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pacientes",
            "{{testPatientId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Paciente encontrado\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Actualizar paciente",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pacientes/{{testPatientId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pacientes",
            "{{testPatientId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Paciente Prueba Actualizado\",\n  \"documento\": \"99999999\",\n  \"telefono\": \"900000001\",\n  \"comunidad\": \"Acobamba\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Actualizado\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Eliminar paciente",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/pacientes/{{testPatientId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pacientes",
            "{{testPatientId}}"
          ]
        }
      },
